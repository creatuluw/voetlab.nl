# .wiki_ignore — files/dirs excluded from staleness detection / file-tree generation
# Add project-specific patterns below. Lines starting with # are comments.

node_modules/
dist/
build/
.next/
.cache/
__pycache__/
.pytest_cache/
.pi/
.DS_Store

# VCS internals: git object store is content-addressed (changes every commit); no knowledge value.
.git/
# Regenerable test artifacts already covered by tests/ but exclude the dump dir explicitly.
tests/out/
